# Convertimos las variables de control a factores
data <- data %>%
mutate(across(c(
# Variables SAE
disclosure, inf_situacional, control_humano,
# Variables FONASA
ai_disclosure_fonasa, control_humano_fonasa, performance_fonasa
), as.factor))
data <- data%>%
filter(eliminado == 0)
library(sjPlot)
names(data)
run_models_sae <- function(dv, data) {
formulas <- c(
"{dv} ~ disclosure + inf_situacional + control_humano + genero + edad_num + education_recoded",
"{dv} ~ disclosure + inf_situacional + control_humano + genero + edad_num + education_recoded + sae_comp_objetiva_pos",
"{dv} ~ disclosure + inf_situacional + control_humano + genero + edad_num + education_recoded + sae_comp_subjetiva_pos",
"{dv} ~ disclosure + inf_situacional + control_humano + genero + edad_num + education_recoded + sae_comp_objetiva_pos + sae_comp_subjetiva_pos",
"{dv} ~ disclosure*sae_comp_objetiva_pos + inf_situacional + control_humano +  + genero + edad_num + education_recoded + sae_comp_subjetiva_pos",
"{dv} ~ disclosure + inf_situacional*sae_comp_objetiva_pos + control_humano +   genero + edad_num + education_recoded + sae_comp_subjetiva_pos",
"{dv} ~ disclosure + inf_situacional + control_humano*sae_comp_objetiva_pos + genero + edad_num + education_recoded + sae_comp_subjetiva_pos",
"{dv} ~ disclosure*sae_comp_subjetiva_pos + inf_situacional + control_humano + genero + edad_num + education_recoded + sae_comp_objetiva_pos",
"{dv} ~ disclosure + inf_situacional*sae_comp_subjetiva_pos + control_humano + genero + edad_num + education_recoded + sae_comp_objetiva_pos",
"{dv} ~ disclosure + inf_situacional + control_humano*sae_comp_subjetiva_pos + genero + edad_num + education_recoded + sae_comp_objetiva_pos"
)
models <- lapply(formulas, function(f) {
lm(as.formula(glue::glue(f, dv = dv)), data = data)
})
tab_model(
models,
collapse.se = TRUE,
show.ci = FALSE,
show.aic = FALSE,
show.r2 = TRUE,
show.fstat = TRUE,
p.style = "stars"
)
}
