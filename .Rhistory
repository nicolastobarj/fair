plot_clean_hypothesis <- function(df, x_var, y_var, title_text) {
# t-test
formula_obj <- as.formula(paste(y_var, "~", x_var))
t_test <- t.test(formula_obj, data = df)
# Formato editorial del p-valor
p_val <- t_test$p.value
p_label <- ifelse(
p_val < 0.001, "p < 0.001",
ifelse(p_val < 0.05, "p < 0.05",
paste0("p = ", round(p_val, 3)))
)
