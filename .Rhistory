fonasa_conf_word_funcional_pos = rowMeans(select(., fonasa_pos_trust_func_reliab_1, fonasa_pos_trust_func_reliab_2, fonasa_pos_trust_func_reliab_3, fonasa_pos_trust_func_capab_1, fonasa_pos_trust_func_capab_2, fonasa_pos_trust_func_capab_3), na.rm = TRUE),
# Promedio constructos con palabras confianza moral
fonasa_conf_word_moral_pre = rowMeans(select(., fonasa_pre_trust_moral_ethi_1, fonasa_pre_trust_moral_ethi_2, fonasa_pre_trust_moral_ethi_3, fonasa_pre_trust_moral_sinc_1, fonasa_pre_trust_moral_sinc_2, fonasa_pre_trust_moral_sinc_3), na.rm = TRUE),
fonasa_conf_word_moral_pos = rowMeans(select(., fonasa_pos_trust_moral_ethi_1, fonasa_pos_trust_moral_ethi_2, fonasa_pos_trust_moral_ethi_3, fonasa_pos_trust_moral_sinc_1, fonasa_pos_trust_moral_sinc_2, fonasa_pos_trust_moral_sinc_3), na.rm = TRUE),
# Promedio comprensión subjetiva
