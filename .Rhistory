# calcular frecuencia y proporción para cada strike individual
group_by(strike_variable) %>%
summarise(
frecuencia = sum(value == 1),
porcentaje = round(100 * mean(value == 1), 2)
) %>%
# añadir la fila final: casos con 2 o más strikes
bind_rows(
tibble(
strike_variable = "eliminados",
frecuencia = sum(data$total_strike >= 2),
porcentaje = round(100 * mean(data$total_strike >= 2), 2)
)
)
tabla_strikes|>
kable()
