geom_ribbon(
aes(ymin = conf.low, ymax = conf.high, fill = group),
alpha = 0.15,
color = NA
) +
labs(
x = "Device Type: Mobile",
y = "Objective comprehension (SAE, post)",
color = "Human control",
fill  = "Human control"
) +
scale_color_manual(
values = c("0" = "#1B9E77", "1" = "#D95F02"),
labels = c("0" = "Computer", "1" = "Mobile")
) +
scale_fill_manual(
values = c("0" = "#1B9E77", "1" = "#D95F02"),
labels = c("0" = "Computer", "1" = "Mobile")
) +
theme_minimal(base_size = 13) +
theme(
legend.position = "top"
)
data <- data %>%
mutate(
device_type = factor(
device_type,
levels = c("computer", "mobile")  # referencia clara
),
control_humano = factor(
control_humano,
levels = c(0, 1)
)
)
