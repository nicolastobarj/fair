fonasa_comp_subjetiva_pos = rowMeans(select(., fonasa_pos_comp_subj_1, fonasa_pos_comp_subj_2, fonasa_pos_comp_subj_3, fonasa_pos_comp_subj_4), na.rm = TRUE),
fonasa_comp_subjetiva_otros_pos = rowMeans(select(., fonasa_pos_comp_subj_5, fonasa_pos_comp_subj_6, fonasa_pos_comp_subj_7, fonasa_pos_comp_subj_8, fonasa_pos_comp_subj_9, fonasa_pos_comp_subj_10), na.rm = TRUE),
# Suma de respuestas (correctas valen 1, No sé o incorrectas 0)
fonasa_comp_objetiva_pre = rowSums(select(., fonasa_pre_comp_obj_1, fonasa_pre_comp_obj_2, fonasa_pre_comp_obj_3, fonasa_pre_comp_obj_4, fonasa_pre_comp_obj_5, fonasa_pre_comp_obj_6), na.rm = TRUE),
