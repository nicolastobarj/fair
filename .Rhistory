) %>%
ggplot(aes(
x = x,
y = predicted,
color = group
)) +
geom_line(linewidth = 1.2) +
geom_ribbon(
aes(ymin = conf.low, ymax = conf.high, fill = group),
alpha = 0.15,
color = NA
) +
labs(
x = "Device type",
y = "Objective comprehension (SAE, post)",
color = "Human control",
fill  = "Human control"
) +
scale_color_manual(
values = c("0" = "#1B9E77", "1" = "#D95F02"),
labels = c("0" = "No human control", "1" = "Human control")
) +
scale_fill_manual(
values = c("0" = "#1B9E77", "1" = "#D95F02"),
labels = c("0" = "No human control", "1" = "Human control")
) +
theme_minimal(base_size = 13) +
theme(
legend.position = "top"
)
