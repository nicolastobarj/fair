#crea columna con los valores de las variables siguientes
datos <- datos %>%
mutate(
# Promedio constructo McKnight confianza funcional
sae_conf_belief_funcional_pre = rowMeans(select(., sae_pre_trust_belief_reliab_1, sae_pre_trust_belief_reliab_2, sae_pre_trust_belief_reliab_3, sae_pre_trust_belief_reliab_4, sae_pre_trust_belief_func_1, sae_pre_trust_belief_func_2, sae_pre_trust_belief_func_3), na.rm = TRUE),
sae_conf_belief_funcional_pos = rowMeans(select(., sae_pos_trust_belief_reliab_1, sae_pos_trust_belief_reliab_2, sae_pos_trust_belief_reliab_3, sae_pos_trust_belief_reliab_4, sae_pos_trust_belief_func_1, sae_pos_trust_belief_func_2, sae_pos_trust_belief_func_3), na.rm = TRUE),
# Promedio constructo McKnight confianza moral
sae_conf_belief_moral_pre = rowMeans(select(., sae_pre_trust_belief_help_1, sae_pre_trust_belief_help_2, sae_pre_trust_belief_help_3, sae_pre_trust_belief_help_4), na.rm = TRUE),
sae_conf_belief_moral_pos = rowMeans(select(., sae_pos_trust_belief_help_1, sae_pos_trust_belief_help_2, sae_pos_trust_belief_help_3, sae_pos_trust_belief_help_4), na.rm = TRUE),
# Promedio constructos con palabras confianza funcional
sae_conf_word_funcional_pre = rowMeans(select(., sae_pre_trust_func_reliab_1, sae_pre_trust_func_reliab_2, sae_pre_trust_func_reliab_3, sae_pre_trust_func_capab_1, sae_pre_trust_func_capab_2, sae_pre_trust_func_capab_3), na.rm = TRUE),
sae_conf_word_funcional_pos = rowMeans(select(., sae_pos_trust_func_reliab_1, sae_pos_trust_func_reliab_2, sae_pos_trust_func_reliab_3, sae_pos_trust_func_capab_1, sae_pos_trust_func_capab_2, sae_pos_trust_func_capab_3), na.rm = TRUE),
# Promedio constructos con palabras confianza moral
sae_conf_word_moral_pre = rowMeans(select(., sae_pre_trust_moral_ethi_1, sae_pre_trust_moral_ethi_2, sae_pre_trust_moral_ethi_3, sae_pre_trust_moral_sinc_1, sae_pre_trust_moral_sinc_2, sae_pre_trust_moral_sinc_3), na.rm = TRUE),
sae_conf_word_moral_pos = rowMeans(select(., sae_pos_trust_moral_ethi_1, sae_pos_trust_moral_ethi_2, sae_pos_trust_moral_ethi_3, sae_pos_trust_moral_sinc_1, sae_pos_trust_moral_sinc_2, sae_pos_trust_moral_sinc_3), na.rm = TRUE),
# Promedio comprensión subjetiva
sae_comp_subjetiva_pre = rowMeans(select(., sae_pre_comp_subj_1, sae_pre_comp_subj_2, sae_pre_comp_subj_3, sae_pre_comp_subj_4), na.rm = TRUE),
sae_comp_subjetiva_pos = rowMeans(select(., sae_pos_comp_subj_1, sae_pos_comp_subj_2, sae_pos_comp_subj_3, sae_pos_comp_subj_4), na.rm = TRUE),
sae_comp_subjetiva_otros_pos = rowMeans(select(., sae_pos_comp_subj_5, sae_pos_comp_subj_6, sae_pos_comp_subj_7, sae_pos_comp_subj_8, sae_pos_comp_subj_9), na.rm = TRUE),
# Suma de respuestas (correctas valen 1, No sé o incorrectas 0)
sae_comp_objetiva_pre = rowSums(select(., sae_pre_comp_obj_1, sae_pre_comp_obj_2, sae_pre_comp_obj_3, sae_pre_comp_obj_4, sae_pre_comp_obj_5, sae_pre_comp_obj_6), na.rm = TRUE),
sae_comp_objetiva_pos = rowSums(select(., sae_pos_comp_obj_1, sae_pos_comp_obj_2, sae_pos_comp_obj_3, sae_pos_comp_obj_4, sae_pos_comp_obj_5, sae_pos_comp_obj_6), na.rm = TRUE),
# Suma de respuestas de los manipulation checks
sae_man_check_algoritmo = rowMeans(select(., sae_man_check_alg1, sae_man_check_alg2, sae_man_check_alg3), na.rm = TRUE),
sae_man_check_infosit = rowMeans(select(., sae_man_check_is1, sae_man_check_is2, sae_man_check_is3), na.rm = TRUE),
sae_man_check_controlh = rowMeans(select(., sae_man_check_ch1, sae_man_check_ch2, sae_man_check_ch3), na.rm = TRUE),
