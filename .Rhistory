run_models_sae("sae_conf_word_moral_pos", data)
run_models_sae("sae_conf_belief_funcional_pos", data)
run_models_sae("sae_conf_belief_moral_pos", data)
run_models_sae("sae_conf_word_funcional_pos", data)
