# Función que calcula y formatea la etiqueta Media (SD)
media_sd_label <- function(x) {
# Calculamos la media (m) y la desviación estándar (s), ignorando NAs
m <- mean(x, na.rm = TRUE)
s <- sd(x, na.rm = TRUE)
# CRÍTICO: Usa format(..., nsmall = 2) para asegurar que la Media siempre tenga dos decimales
mean_formatted <- format(round(m, 2), nsmall = 2)
# Definimos dónde colocar la etiqueta (ligeramente por encima del valor máximo)
y_pos <- 5.1
# Formateamos el texto: Media (SD)
mean_formatted <- format(round(m, 2), nsmall = 2)
label_text <- paste0(mean_formatted, "\n(", round(s, 2), ")") # Usamos \n para salto de línea
# Devolvemos un data frame que ggplot puede leer
return(data.frame(y = y_pos, label = label_text))
}
