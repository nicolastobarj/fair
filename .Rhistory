# 1. Definir los ítems basados en tu lista
items_fonasa <- paste0("fonasa_pos_comp_obj_", 1:11)
items_sae    <- paste0("sae_pre_comp_obj_", 1:6)
# 2. Función para ejecutar el modelo 2PL (Discriminación y Dificultad)
validar_irt_sistema <- function(df, columnas, nombre_sistema) {
# Seleccionamos solo los datos necesarios y eliminamos NAs para el test
datos_irt <- df %>% select(all_of(columnas)) %>% na.omit()
# Ajustamos un modelo de 1 factor usando 2 Parámetros Logísticos (2PL)
modelo <- mirt(datos_irt, 1, itemtype = '2PL', verbose = FALSE)
# Extraemos parámetros de los ítems
# a = Discriminación (qué tan bien diferencia el ítem)
# b = Dificultad (nivel de habilidad necesario para el 50% de éxito)
parametros <- coef(modelo, IRTpars = TRUE, simplify = TRUE)$items %>%
as.data.frame() %>%
mutate(Sistema = nombre_sistema, Item = row.names(.)) %>%
select(Sistema, Item, a, b)
return(list(modelo = modelo, tabla = parametros))
}
# 3. Ejecutar análisis
res_fonasa <- validar_irt_sistema(data, items_fonasa, "FONASA (Post)")
res_sae    <- validar_irt_sistema(data, items_sae, "SAE (Pre)")
# 4. Tabla de resultados integrada
tabla_final_irt <- bind_rows(res_fonasa$tabla, res_sae$tabla)
kable(tabla_final_irt, digits = 2, booktabs = TRUE,
caption = "Parámetros IRT (Modelo 2PL) para Comprensión Objetiva",
col.names = c("Sistema", "Ítem", "Discriminación (a)", "Dificultad (b)")) %>%
kable_styling(latex_options = "striped")
names(data)
