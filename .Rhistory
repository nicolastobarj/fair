"Situational information (Ex ante)",
"Algorithmic disclosure (Ex ante)",
"Man. Check Human control",
"Man. Check Situational information",
"Man. Check Algorithmic disclosure",
"Género: Hombre",
"Edad",
"Educación: Media completa",
"Educación: Superior"
),
dv.labels = c(
"Objective knowledge (Ex post)",
"Subjective knowledge (Ex post)",
"Moral trust McKnight (Ex post)",
"Functional trust McKnight (Ex post)"
)
)
