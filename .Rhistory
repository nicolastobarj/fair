mutate(across(all_of(columnas_a_recodificar), ~ case_when(
. == "Muy en desacuerdo" ~ 1,
. == "En desacuerdo" ~ 2,
. == "Ni en desacuerdo ni de acuerdo" ~ 3,
. == "De acuerdo" ~ 4,
. == "Muy de acuerdo" ~ 5,
TRUE ~ as.numeric(.) # Mantiene los valores que ya eran numéricos o NA
)))
# En negativo de Muy de acuerdo a Muy en desacuerdo
columnas_manipulation <- c(
# manipulaciones al final
"sae_man_check_is3", "sae_man_check_alg3", "sae_man_check_ch3",
#actitudes generales hacia la IA
"general_attitudes_AI2", "general_attitudes_AI4", "general_attitudes_AI5", "general_attitudes_AI8",
#fonasa manipulation check
"fonasa_man_check_aid2", "fonasa_man_check_ch2", "fonasa_man_check_p1"
)
datos <- datos %>%
mutate(across(all_of(columnas_manipulation), ~ case_when(
. == "Muy en desacuerdo" ~ 5,
. == "En desacuerdo" ~ 4,
. == "Ni en desacuerdo ni de acuerdo" ~ 3,
. == "De acuerdo" ~ 2,
. == "Muy de acuerdo" ~ 1,
TRUE ~ as.numeric(.) # Mantiene los valores que ya eran numéricos o NA
)))
# En positivo de Completamente a En absoluto
columnas_a_recodificar <- c(
# pre
"sae_pre_comp_subj_1", "sae_pre_comp_subj_2", "sae_pre_comp_subj_3", "sae_pre_comp_subj_4",
# pos
"sae_pos_comp_subj_1", "sae_pos_comp_subj_2", "sae_pos_comp_subj_3", "sae_pos_comp_subj_4",
#otros pos
"sae_pos_comp_subj_5", "sae_pos_comp_subj_6", "sae_pos_comp_subj_7", "sae_pos_comp_subj_8", "sae_pos_comp_subj_9",
#fonasa
"fonasa_pre_comp_subj_1", "fonasa_pre_comp_subj_2", "fonasa_pre_comp_subj_3", "fonasa_pre_comp_subj_4",
"fonasa_pos_comp_subj_1", "fonasa_pos_comp_subj_2", "fonasa_pos_comp_subj_3", "fonasa_pos_comp_subj_4", "fonasa_pos_comp_subj_5", "fonasa_pos_comp_subj_6",
"fonasa_pos_comp_subj_7", "fonasa_pos_comp_subj_8", "fonasa_pos_comp_subj_9", "fonasa_pos_comp_subj_10"
)
datos <- datos %>%
mutate(across(all_of(columnas_a_recodificar), ~ case_when(
. == "En absoluto" ~ 1,
. == "Poco" ~ 2,
. == "Moderadamente" ~ 3,
. == "Bastante" ~ 4,
. == "Completamente" ~ 5,
TRUE ~ as.numeric(.) # Mantiene los valores que ya eran numéricos o NA
)))
#Preguntas de conocimiento objetivo
columnas_objetivas_a_evaluar <- c(
"sae_pre_comp_obj_1", "sae_pre_comp_obj_2", "sae_pre_comp_obj_3", "sae_pre_comp_obj_4", "sae_pre_comp_obj_5", "sae_pre_comp_obj_6",
"sae_pos_comp_obj_1", "sae_pos_comp_obj_2", "sae_pos_comp_obj_3", "sae_pos_comp_obj_4", "sae_pos_comp_obj_5", "sae_pos_comp_obj_6"
)
datos <- datos %>%
mutate(
across(all_of(columnas_objetivas_a_evaluar), ~ case_when(
. == "Eligiendo cuántas escuelas incluir en su lista y el orden de preferencia." ~ 1,
. == "El sistema toma mucho en cuenta la lista de escuelas que eligen los apoderados." ~ 1,
. == "Se ordenan según un número que el sistema asigna antes." ~ 1,
. == "El algoritmo realiza pasos adicionales cuando una escuela no tiene cupos suficientes." ~ 1,
. == "Se debe esperar la respuesta del sistema, y de acuerdo a eso, determinar los pasos a seguir." ~ 1,
. == "Esperar a que se le asigne la escuela gratuita más cercana al domicilio." ~ 1,
# CONDICIÓN FINAL: Si no cumple las condiciones anteriores (es incorrecta) -> ASIGNAR 0
TRUE ~ 0
)))
#Preguntas de AI skills
columnas_ai_skills <- c(
"alfabetizacion_digital1",	"alfabetizacion_digital2",	"alfabetizacion_digital3",	"alfabetizacion_digital4",	"alfabetizacion_digital5", "alfabetizacion_digital6",	"alfabetizacion_digital7",	"alfabetizacion_digital8",	"alfabetizacion_digital9",	"alfabetizacion_digital10", "alfabetizacion_digital11", "alfabetizacion_digital12", "alfabetizacion_digital13", "alfabetizacion_digital14", "alfabetizacion_digital15", "alfabetizacion_digital16", "AI_Skills1", "AI_Skills2", "AI_Skills3", "AI_Skills4", "AI_Skills5", "AI_Skills6", "AI_Skills7", "AI_Skills8", "AI_Skills9", "AI_Skills10", "AI_Skills11", "AI_Skills12", "AI_Skills13", "AI_Skills14", "AI_Skills15", "AI_Skills16", "AI_Skills17", "AI_Skills18", "AI_Skills19"
)
datos <- datos %>%
