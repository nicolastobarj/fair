# Definir función para calcular Spearman-Brown
calcular_split_half <- function(df, cols, nombre_test) {
# Limpiar NAs
dat <- df[, cols] %>% na.omit()
# splitHalf calcula automáticamente varias formas de partición
# Tomamos la partición estandarizada (Spearman-Brown)
res <- splitHalf(dat, raw = FALSE)
data.frame(
Bateria = nombre_test,
Items = length(cols),
n_sujetos = nrow(dat),
Spearman_Brown = res$maxrb, # Coeficiente corregido (máxima confiabilidad)
Guttman_L4 = res$lambda4    # Otro indicador robusto de mitades
)
}
# 2. Ejecutar para todas las baterías
sh_fonasa_pre <- calcular_split_half(data, items_fonasa_pre, "FONASA Pre (Objetiva)")
