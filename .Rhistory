library(ggplot2)
library(patchwork) # Para unir los gráficos
library(dplyr)
plot_clean_hypothesis <- function(df, x_var, y_var, title_text) {
# t-test
formula_obj <- as.formula(paste(y_var, "~", x_var))
t_test <- t.test(formula_obj, data = df)
# Formato editorial del p-valor
p_val <- t_test$p.value
p_label <- ifelse(
p_val < 0.001, "p < 0.001",
ifelse(p_val < 0.05, "p < 0.05",
paste0("p = ", round(p_val, 3)))
)
ggplot(df, aes_string(x = x_var, y = y_var)) +
# Media + IC 95%
stat_summary(
fun.data = function(x) mean_cl_normal(x, conf.int = 0.95),
geom = "errorbar",
width = 0.1,
size = 0.8
) +
stat_summary(fun = "mean", geom = "point", size = 3) +
# Línea que conecta las medias
stat_summary(
fun = "mean",
geom = "line",
aes(group = 1),
linetype = "solid",
alpha = 0.5
) +
labs(
subtitle = paste0(title_text, "\n(", p_label, ")"),
x = NULL,
y = NULL
) +
theme_minimal() +
theme(
plot.subtitle = element_text(size = 9, face = "italic"),
panel.grid.minor = element_blank()
)
}
