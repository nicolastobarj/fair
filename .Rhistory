control_humano + inf_situacional + disclosure +
sae_man_check_controlh + sae_man_check_infosit + sae_man_check_algoritmo +
genero + edad_num + education_recoded,
data = data)
),
collapse.se = TRUE,
show.ci = FALSE,
show.aic = FALSE,
show.r2 = TRUE,
show.fstat = TRUE,
p.style = "stars",
pred.labels = c(
"Intercept",
