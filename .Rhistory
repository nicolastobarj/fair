run_models <- function(moderator, moderator_label) {
m1 <- as.formula(paste("sae_comp_objetiva_pre ~ disclosure +", moderator))
f1 <- as.formula(paste("sae_comp_objetiva_pre ~ disclosure *", moderator))
m2 <- as.formula(paste("sae_comp_subjetiva_pre ~ disclosure +", moderator))
f2 <- as.formula(paste("sae_comp_subjetiva_pre ~ disclosure *", moderator))
m3 <- as.formula(paste("sae_conf_word_moral_pre ~ disclosure +", moderator))
f3 <- as.formula(paste("sae_conf_word_moral_pre ~ disclosure *", moderator))
m4 <- as.formula(paste("sae_conf_word_funcional_pre ~ disclosure +", moderator))
f4 <- as.formula(paste("sae_conf_word_funcional_pre ~ disclosure *", moderator))
m5 <- as.formula(paste("sae_conf_belief_moral_pre ~ disclosure +", moderator))
f5 <- as.formula(paste("sae_conf_belief_moral_pre ~ disclosure *", moderator))
m6 <- as.formula(paste("sae_conf_belief_funcional_pre ~ disclosure +", moderator))
f6 <- as.formula(paste("sae_conf_belief_funcional_pre ~ disclosure *", moderator))
tab_model(
list(
lm(m1, data = data),
lm(f1, data = data),
lm(m2, data = data),
lm(f2, data = data),
lm(m3, data = data),
lm(f3, data = data),
lm(m4, data = data),
lm(f4, data = data),
lm(m5, data = data),
lm(f5, data = data),
lm(m6, data = data),
lm(f6, data = data)
),
collapse.se = TRUE,
show.ci = FALSE,
show.aic = FALSE,
show.r2 = TRUE,
show.fstat = TRUE,
p.style = "stars",
dv.labels = c(
"Objective knowledge (Ex-Ante)",
"Objective knowledge (Ex-Ante)",
"Subjective knowledge (Ex-Ante)",
"Subjective knowledge (Ex-Ante)",
"Moral trust MDMT (Ex-Ante)",
"Moral trust MDMT (Ex-Ante)",
"Functional trust MDMT (Ex-Ante)",
"Functional trust MDMT (Ex-Ante)",
"Moral trust McKnight (Ex-Ante)",
"Moral trust McKnight (Ex-Ante)",
"Functional trust McKnight (Ex-Ante)",
"Functional trust McKnight (Ex-Ante)"
),
pred.labels = c(
"Intercept",
"Disclosure (Ex-Ante)",
moderator_label,
paste("Disclosure ×", moderator_label)
)
)
}
run_models("sae_familiaridad_recode", "SAE familiarity: Yes")
