# Tabla consolidada de strikes
strike_table <- data %>%
mutate(
# Criterio final de eliminación:
# 1) Eliminados automáticamente por strike_double_atencion = 1
# 2) Eliminados si tienen 2 o más strikes (pero excluyendo strike_double_atencion para este conteo)
strike_count_no_double = strike_time + strike_variance +
if_else(strike_one_atencion %in% c(1,2), 1, 0),
eliminado = case_when(
strike_double_atencion == 1 ~ 1,
strike_count_no_double >= 2 ~ 1,
TRUE ~ 0
)
) %>%
summarise(
strike_double_atencion = sum(strike_double_atencion),
strike_one_atencion_saefonasa = sum(strike_one_atencion == 2),
strike_time = sum(strike_time),
strike_variance = sum(strike_variance),
eliminados = sum(eliminado)
) %>%
pivot_longer(
cols = everything(),
names_to = "categoria",
values_to = "frecuencia"
) %>%
mutate(
proporcion = frecuencia / nrow(data)
)
strike_table
strike_table|>
kable()
# ------------------------------------------------------------
# 1. Crear indicador de fallas de attention check
# ------------------------------------------------------------
data <- data %>%
mutate(
att_fail_category = case_when(
strike_double_atencion == 1 ~ "double_fail",
strike_one_atencion == 1 ~ "comun_fail",
strike_one_atencion == 2 ~ "sae_fonasa_fail",
TRUE ~ "ok"
)
)
# ------------------------------------------------------------
# 2. Función general para graficar varianza vs. attention check
# ------------------------------------------------------------
make_att_plot <- function(df, varname, title, threshold = 0.15){
ggplot(df, aes(x = .data[[varname]],
y = att_fail_category,
color = att_fail_category)) +
geom_jitter(height = 0.1, alpha = 0.6) +
geom_vline(xintercept = threshold, linetype = "dashed") +
scale_color_manual(values = c(
"ok" = "black",
"comun_fail" = "blue",
"sae_fonasa_fail" = "orange",
"double_fail" = "red"
)) +
labs(
title = title,
x = "Varianza intrapersonal",
y = "Categoría de fallo en attention check",
color = "Tipo de fallo"
) +
theme_minimal() +
scale_x_continuous(limits = c(0, 1.5))
}
# ------------------------------------------------------------
# 3. Generar los 4 gráficos
# ------------------------------------------------------------
p1 <- make_att_plot(data, "var_fon_pre", "Varianza FONASA PRE vs attention check")
p2 <- make_att_plot(data, "var_fon_pos", "Varianza FONASA POS vs attention check")
p3 <- make_att_plot(data, "var_sae_pre", "Varianza SAE PRE vs attention check")
p4 <- make_att_plot(data, "var_sae_pos", "Varianza SAE POS vs attention check")
# Combinar en grilla
(p1 | p2) /
(p3 | p4)
