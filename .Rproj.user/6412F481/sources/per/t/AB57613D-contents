# Moderación de comprensiones

```{r}
run_models_fonasa <- function(dv, data) {

  formulas <- c(
    "{dv} ~ ai_disclosure_fonasa + control_humano_fonasa + performance_fonasa + genero + edad_num + education_recoded",
    "{dv} ~ ai_disclosure_fonasa + control_humano_fonasa + performance_fonasa + genero + edad_num + education_recoded + fonasa_comp_objetiva_pos",
    "{dv} ~ ai_disclosure_fonasa + control_humano_fonasa + performance_fonasa + genero + edad_num + education_recoded + fonasa_comp_subjetiva_pos",
    "{dv} ~ ai_disclosure_fonasa + control_humano_fonasa + performance_fonasa + genero + edad_num + education_recoded + fonasa_comp_objetiva_pos + fonasa_comp_subjetiva_pos",

    "{dv} ~ ai_disclosure_fonasa*fonasa_comp_objetiva_pos + control_humano_fonasa + performance_fonasa +  + genero + edad_num + education_recoded + fonasa_comp_subjetiva_pos",
    "{dv} ~ ai_disclosure_fonasa + control_humano_fonasa*fonasa_comp_objetiva_pos + performance_fonasa +   genero + edad_num + education_recoded + fonasa_comp_subjetiva_pos",
    "{dv} ~ ai_disclosure_fonasa + control_humano_fonasa + performance_fonasa*fonasa_comp_objetiva_pos + genero + edad_num + education_recoded + fonasa_comp_subjetiva_pos",

    "{dv} ~ ai_disclosure_fonasa*fonasa_comp_subjetiva_pos + control_humano_fonasa + performance_fonasa + genero + edad_num + education_recoded + fonasa_comp_objetiva_pos",
    "{dv} ~ ai_disclosure_fonasa + control_humano_fonasa*fonasa_comp_subjetiva_pos + performance_fonasa + genero + edad_num + education_recoded + fonasa_comp_objetiva_pos",
    "{dv} ~ ai_disclosure_fonasa + control_humano_fonasa + performance_fonasa*fonasa_comp_subjetiva_pos + genero + edad_num + education_recoded + fonasa_comp_objetiva_pos"
  )

  models <- lapply(formulas, function(f) {
    lm(as.formula(glue::glue(f, dv = dv)), data = data)
  })

  tab_model(
    models,
    collapse.se = TRUE,
    show.ci = FALSE,
    show.aic = FALSE,
    show.r2 = TRUE,
    show.fstat = TRUE,
    p.style = "stars"
  )
}

```

```{r}
run_models_fonasa("fonasa_conf_belief_funcional_pos", data)
run_models_fonasa("fonasa_conf_belief_moral_pos", data)
run_models_fonasa("fonasa_conf_word_funcional_pos", data)
run_models_fonasa("fonasa_conf_word_moral_pos", data)
```

